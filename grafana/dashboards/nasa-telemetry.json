{
  "title": "NASA Mission Control - SAT-01",
  "uid": "nasa-sat01",
  "tags": [
    "nasa",
    "telemetry"
  ],
  "timezone": "browser",
  "refresh": "2s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "LIVE TELEMETRY",
      "datasource": "TimescaleDB",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) as packets FROM telemetry",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "BATTERY %",
      "datasource": "TimescaleDB",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "rawSql": "SELECT battery as \"Battery\" FROM telemetry ORDER BY timestamp DESC LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "type": "gauge",
      "title": "TEMPERATURE \u00b0C",
      "datasource": "TimescaleDB",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "targets": [
        {
          "rawSql": "SELECT temperature FROM telemetry ORDER BY timestamp DESC LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -50,
          "max": 100,
          "unit": "celsius",
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": -50
              },
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "ALTITUDE km",
      "datasource": "TimescaleDB",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "rawSql": "SELECT altitude FROM telemetry ORDER BY timestamp DESC LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthkm"
        }
      }
    },
    {
      "type": "stat",
      "title": "SIGNAL %",
      "datasource": "TimescaleDB",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "rawSql": "SELECT signal_strength as signal FROM telemetry ORDER BY timestamp DESC LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Battery History (last 15m)",
      "datasource": "TimescaleDB",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp as time, battery FROM telemetry WHERE timestamp > NOW() - INTERVAL '15 minutes' ORDER BY timestamp",
          "format": "time_series"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Temperature / Altitude",
      "datasource": "TimescaleDB",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp as time, temperature FROM telemetry WHERE timestamp > NOW() - INTERVAL '15 minutes' ORDER BY timestamp",
          "format": "time_series"
        },
        {
          "rawSql": "SELECT timestamp as time, altitude FROM telemetry WHERE timestamp > NOW() - INTERVAL '15 minutes' ORDER BY timestamp",
          "format": "time_series"
        }
      ]
    }
  ]
}