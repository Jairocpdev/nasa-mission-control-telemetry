{
  "title": "NASA Mission Control - SAT-01",
  "uid": "nasa-sat01",
  "tags": [
    "nasa",
    "telemetry"
  ],
  "timezone": "browser",
  "refresh": "2s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LIVE TELEMETRY",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "rawSql": "SELECT COUNT(*) as value FROM telemetry",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "BATTERY %",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "rawSql": "SELECT battery FROM telemetry ORDER BY timestamp DESC LIMIT 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "TEMPERATURE \u00b0C",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "targets": [
        {
          "rawSql": "SELECT temperature FROM telemetry ORDER BY timestamp DESC LIMIT 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -50,
          "max": 100,
          "unit": "celsius"
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ALTITUDE km",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "rawSql": "SELECT altitude FROM telemetry ORDER BY timestamp DESC LIMIT 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthkm"
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "SIGNAL %",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "rawSql": "SELECT signal FROM telemetry ORDER BY timestamp DESC LIMIT 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Battery History",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp as time, battery FROM telemetry WHERE timestamp > NOW() - INTERVAL '1 hour' ORDER BY timestamp",
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Temperature / Altitude / Signal",
      "datasource": {
        "type": "postgres",
        "uid": "TimescaleDB"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "rawSql": "SELECT timestamp as time, temperature FROM telemetry WHERE timestamp > NOW() - INTERVAL '1 hour' ORDER BY timestamp",
          "format": "time_series",
          "refId": "A"
        },
        {
          "rawSql": "SELECT timestamp as time, altitude FROM telemetry WHERE timestamp > NOW() - INTERVAL '1 hour' ORDER BY timestamp",
          "format": "time_series",
          "refId": "B"
        },
        {
          "rawSql": "SELECT timestamp as time, signal FROM telemetry WHERE timestamp > NOW() - INTERVAL '1 hour' ORDER BY timestamp",
          "format": "time_series",
          "refId": "C"
        }
      ]
    }
  ]
}